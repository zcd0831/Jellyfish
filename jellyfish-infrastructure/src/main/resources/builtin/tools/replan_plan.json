{
  "id": "replan_plan",
  "name": "replan_plan",
  "description": "原计划执行失败后，给出修正后的剩余步骤（只替换未执行的尾部）。只在被要求重划时使用。",
  "inputSchema": {
    "type": "object",
    "required": ["steps"],
    "properties": {
      "steps": {
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "items": {
          "type": "object",
          "required": ["description"],
          "properties": {
            "description": {"type": "string", "description": "这一步要做什么，可验证的具体动作"},
            "goal": {"type": "string", "description": "这一步的原定目标（裁判要用）"},
            "expectedOutcome": {"type": "string", "description": "这一步做完后应该看到的结果（裁判要用）"},
            "verificationCriteria": {"type": "string", "description": "判定这一步是否达成的标准"},
            "verifications": {
              "type": "array",
              "items": {"enum": ["DETERMINISTIC", "ENV_FEEDBACK", "LLM_JUDGE", "HUMAN_APPROVAL"]},
              "description": "这一步需要哪些验证层；为空表示模型自证"
            },
            "tools": {
              "type": "array",
              "items": {"type": "string"},
              "description": "这一步预计会用到的工具名"
            },
            "dependsOn": {
              "type": "array",
              "items": {"type": "integer", "minimum": 1},
              "description": "依赖的前置步骤序号（1 基）"
            }
          }
        }
      }
    }
  },
  "outputSchema": {"type": "object", "properties": {"result": {"type": "string"}}},
  "source": {"type": "INTERNAL", "endpointOrIdentifier": "replan_plan"},
  "sideEffect": "READ_ONLY",
  "timeoutMillis": 0,
  "status": "ACTIVE"
}
