# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# IDE
.idea

# macOS Finder 元数据（会在仓库里到处生成，不该进版本库）
.DS_Store
**/.DS_Store

# Maven build output
target/

# 插件安装目录：PF4J 从工作目录下的 plugins/ 加载插件 jar，
# 它是本地装配产物（由 mvn package 后手工复制得到），不入版本库
/plugins/

# maven-shade-plugin 生成的构建产物（createDependencyReducedPom）
dependency-reduced-pom.xml
