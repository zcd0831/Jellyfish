<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>zcd</groupId>
        <artifactId>jellyfish</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>jellyfish-script</artifactId>
    <name>Jellyfish Script</name>
    <description>跨语言插件运行时：协议、清单、进程生命周期、事件桥接与熔断（语言无关机制层）。</description>

    <dependencies>
        <!-- 内核契约：必须 provided。本模块会被桥接插件 shade 进插件包，而
             PluginClasspathGuard 禁止插件包内出现 zcd/jellyfish/api —— 自带会让
             JellyfishPlugin / PluginContext 在子优先类加载器下出现两份互不相识的类型。 -->
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 日志：与内核同源（宿主已有 slf4j），同样走 provided 由父加载器提供。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Jackson：内核的 ObjectMapperWrapper 在 jellyfish-infra 里、插件看不到它，
             因此本模块自带一份并 shade 进插件包（与 jellyfish-plugin-todo 同款做法）。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- 参数名模块是必需的，不是可选优化：会话快照这类 api 值类型是「全字段构造器 + 无 setter」
             的不可变对象，Jackson 只能靠构造器参数名反序列化，而参数名又依赖编译期 -parameters。
             少了它，session_persist / session_restore 会直接报「no delegate- or property-based Creator」
             ——表现为「脚本写得出、读不回」。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-parameter-names</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Apache Commons Exec：子进程启动、stdout/stderr 泵送与进程级看门狗。
             它只在 ScriptProcess（P3）里使用，但作为本模块对外承诺的依赖先声明，
             免得桥接插件的 shade 配置在 P3 才需要跟着改。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-exec</artifactId>
        </dependency>

        <!-- 单元测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 仅测试期使用：注册器要验证的正是「处理器真的落进了内核注册表」，
             因此用它真实的 PluginContext / ExtensionRegistry 跑一遍，
             而不是在测试里另造一套假注册表（那样测的就不是内核看到的东西了）。
             注意本模块对内核契约本身仍是 provided，不带入运行期 classpath。 -->
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-infra</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
