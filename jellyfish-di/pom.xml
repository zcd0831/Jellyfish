<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>zcd</groupId>
        <artifactId>jellyfish</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>jellyfish-di</artifactId>
    <name>Jellyfish DI</name>
    <description>【装配层】把 infra / core 的实现装配成一张完整的对象图：Dagger2 组件与 Module（composition root），以及不依赖 Dagger 的手动装配工厂。</description>

    <dependencies>
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-infra</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
        </dependency>
        <!-- LlmModule 直接构造 OkHttpClient，因此这里显式声明（而非吃 infra 的传递依赖） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>

        <!-- 单元测试：装配契约（JUnit5 + Mockito，版本由父 POM 的 BOM 统一管理） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 内联 mock maker：装配契约断言的是 final 运行时组件（PF4JPluginManager 等），
             只有内联模式才能对它们做同一性断言（与 jellyfish-core 同一口径） -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-inline</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
