{
  "entry": "main.py",
  "tools": [
    {
      "name": "hello_greet",
      "description": "按名字打招呼；这是只读工具",
      "parameters": {
        "name": {
          "type": "string",
          "description": "要打招呼的人"
        }
      },
      "required": ["name"],
      "readOnly": true
    },
    {
      "name": "hello_remember",
      "description": "把一句话记到本脚本目录下的 notes.txt",
      "parameters": {
        "note": {
          "type": "string",
          "description": "要记下的一句话"
        }
      },
      "required": ["note"]
    }
  ],
  "commands": [
    {
      "name": "hello",
      "descriptor": {
        "summary": "和示例脚本打个招呼",
        "usage": "/hello <名字>",
        "aliases": ["hi"]
      }
    }
  ],
  "commandOptions": [
    {
      "name": "hello"
    }
  ],
  "contributions": ["prompt", "status_line"],
  "events": ["ToolCallCompletedEvent"]
}
