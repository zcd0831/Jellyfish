<project xmlns="http://maven.apache.org/POM/4.0.0"
         child.project.url.inherit.append.path="false"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.zcd0831</groupId>
    <artifactId>jellyfish</artifactId>
    <version>1.0.0-alpha</version>
    <name>Jellyfish</name>
    <description>用 Java 8 编写的本地终端 AI Agent：领域分层、显式端口、文件系统持久化。</description>
    <packaging>pom</packaging>

    <!-- 发布到 Maven Central 的硬性元数据：url / licenses / developers / scm 缺一不可。
         校验看的是「有效模型」，所以这里声明一次、子模块继承即可。 -->
    <url>https://github.com/zcd0831/Jellyfish</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>zcd0831</id>
            <name>zcd</name>
            <email>zcd0831@users.noreply.github.com</email>
            <url>https://github.com/zcd0831</url>
        </developer>
    </developers>
    <!-- scm 的三个字段会被子模块继承并追加 artifactId，拼出的地址是 404；
         三个 child.scm.*.inherit.append.path="false" 让子模块沿用同一个仓库地址。 -->
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:git://github.com/zcd0831/Jellyfish.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/zcd0831/Jellyfish.git</developerConnection>
        <url>https://github.com/zcd0831/Jellyfish</url>
    </scm>

    <!-- 全量重建：旧实现留在 tag v0.1.2-final。
         模块按「技术决策 D15」的切片逐个加入，依赖方向见 AGENTS.md。 -->
    <modules>
        <module>jellyfish-domain</module>
        <module>jellyfish-application</module>
        <module>jellyfish-infrastructure</module>
        <module>jellyfish-shell</module>
        <module>jellyfish-di</module>
        <module>jellyfish-boot</module>
    </modules>

    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <!-- 源码与文档编码：不写就按机器平台编码取，中文 Windows 上会乱码。 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 版本统一在此声明；Java 8 可用的较新版，实际编译验证以构建结果为准。 -->
        <okhttp.version>4.12.0</okhttp.version>
        <json-schema-validator.version>1.5.8</json-schema-validator.version>
        <lombok.version>1.18.30</lombok.version>
        <dagger.version>2.48</dagger.version>
        <jackson.version>2.17.2</jackson.version>
        <junit.version>5.10.2</junit.version>
        <jtokkit.version>0.6.1</jtokkit.version>

        <maven-compiler-plugin.version>3.11.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块统一版本，子模块引用时不写 version -->
            <dependency>
                <groupId>io.github.zcd0831</groupId>
                <artifactId>jellyfish-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.zcd0831</groupId>
                <artifactId>jellyfish-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.zcd0831</groupId>
                <artifactId>jellyfish-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.zcd0831</groupId>
                <artifactId>jellyfish-shell</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.zcd0831</groupId>
                <artifactId>jellyfish-di</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 值对象样板（技术决策 D04.1：只允许 domain 的值对象使用 @Value） -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- 装配（技术决策 D04：DI 注解只允许出现在 jellyfish-di） -->
            <dependency>
                <groupId>com.google.dagger</groupId>
                <artifactId>dagger</artifactId>
                <version>${dagger.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.dagger</groupId>
                <artifactId>dagger-compiler</artifactId>
                <version>${dagger.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- 序列化（技术决策 D07：Jackson 2.17.x，camelCase、枚举名、epoch 毫秒） -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- HTTP 客户端（技术决策 D16-5 / M14：OkHttp 4.12.0，Java 8 兼容且仍在维护） -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>mockwebserver</artifactId>
                <version>${okhttp.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- 工具入参校验（技术决策 D17：完整 JSON Schema，draft-07） -->
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${json-schema-validator.version}</version>
            </dependency>

            <!-- token 计数策略链的默认实现（技术决策 D08） -->
            <dependency>
                <groupId>com.knuddels</groupId>
                <artifactId>jtokkit</artifactId>
                <version>${jtokkit.version}</version>
            </dependency>

            <!-- 测试（技术决策 D13：JUnit 5，不使用 Mockito） -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                        <!-- Lombok 与 Dagger 同时挂在注解处理器路径上（D04、D04.1） -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>com.google.dagger</groupId>
                                <artifactId>dagger-compiler</artifactId>
                                <version>${dagger.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
