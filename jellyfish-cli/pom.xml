<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>zcd</groupId>
        <artifactId>jellyfish</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>jellyfish-cli</artifactId>
    <name>Jellyfish CLI</name>
    <description>最外层外壳：main 入口、启动模式分发、Dagger2 装配（composition root）与分发打包。</description>

    <dependencies>
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-infra</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 装配层：composition root（Dagger2 组件与 Module）已迁到独立模块，
             这样其他外壳（如 Spring Boot starter）也能复用同一份装配知识 -->
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-di</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-tui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- HTTP 服务外壳：ServerRunMode 只做接线，实现全在 jellyfish-server -->
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
        </dependency>

        <!-- 日志：SLF4J 门面绑到 Log4j2（桥接 + 实现），使内核的 WARN/ERROR 不再是无底洞 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>

        <!-- 单元测试：DI Module 的装配契约（JUnit5 + Mockito，版本由父 POM 的 BOM 统一管理） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打包：产出可直接 java -jar 的可执行 jar。
                 ManifestResourceTransformer 写 Main-Class；ServicesResourceTransformer 保留
                 META-INF/services（Jackson / OkHttp / PF4J 都依赖它）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>shade-executable-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>zcd.jellyfish.cli.JellyfishApplication</mainClass>
                                    <manifestEntries>
                                        <!-- 版本号只写 manifest：JellyfishApplication.version() 从 Package 读，
                                             刻意不用资源过滤（那会把 ${} 替换规则扩散到 config.json） -->
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- 依赖 jar 的签名残留会让合并后的 jar 启动失败 -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!--
                Server 模式的端到端测试：本机回环上起一台真 Undertow + 真内核（Dagger 装配）。

                放在 cli 模块：只有这里拿得到 composition root。它要占端口、会读写用户配置目录，
                因此不进 `mvn test`（AGENTS.md 规定单测不访问外部资源）。
                启用方式：mvn -q -Pserver-it test
            -->
            <id>server-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- 覆盖默认包含规则：本 profile 只跑 *IT -->
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
