<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>zcd</groupId>
        <artifactId>jellyfish-plugins</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>jellyfish-plugin-python</artifactId>
    <name>Jellyfish Plugin Python</name>
    <description>Python 桥接插件：把 Python 脚本插件以标准 PF4J 插件的形式接入内核。</description>

    <dependencies>
        <!-- 内核契约：必须 provided（见 tools 插件的说明） -->
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 日志：与内核同源（宿主已有 slf4j），同样走 provided 由父加载器提供 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 跨语言运行时：compile 而非 provided —— 它会连同 Jackson / Commons Exec 一起
             被 shade 进本插件包。内核 classpath 上不出现这些类，infra/core 也完全不知道脚本进程存在。
             注意 shade 的 includes 必须排除 jellyfish-api 与 org.pf4j：
             PluginClasspathGuard 会拒绝自带内核契约的插件包（子优先类加载器会让
             JellyfishPlugin / PluginContext 出现两份互不相识的类型）。 -->
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-script</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 单测 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 仅测试期使用：加载链路的端到端验证需要真实的 PF4J 管理器与注册表。 -->
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-infra</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 把跨语言运行时与其依赖打进插件包：内核 classpath 上不出现本插件的私有依赖。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>shade-script-runtime</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <artifactSet>
                                <!-- 只打机制的运行时与其自带依赖；jellyfish-api / pf4j / slf4j 由父加载器提供 -->
                                <includes>
                                    <include>zcd:jellyfish-script</include>
                                    <include>com.fasterxml.jackson.core:*</include>
                                    <!-- 参数名模块：api 快照类型靠构造器参数名反序列化，缺了会「写得出、读不回」 -->
                                    <include>com.fasterxml.jackson.module:*</include>
                                    <include>org.apache.commons:commons-exec</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!--
                真实解释器的端到端测试。

                它需要一个真实的 python3，因此不进 `mvn test`（AGENTS.md 规定单测不访问外部资源）。
                这里用 profile 而不是另建模块：被测对象就是本模块的插件与它的网关资源，
                换一个模块反而要把资源再复制一份。

                启用方式：mvn -Pscript-it test
                指定解释器：mvn -Pscript-it test -Djellyfish.test.python=/path/to/python3
            -->
            <id>script-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- 覆盖默认包含规则：本 profile 只跑 *IT，普通单测由 mvn test 负责 -->
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <!--
                                    仓库里的示例脚本目录。端到端用例直接加载它们，
                                    好让「示例能不能用」被一直守着——示例一旦腐烂（改了实现忘了清单、
                                    清单里写着不存在的工具），这里就会红。
                                    刻意不做「向上找仓库根」的猜测：路径写错时用例应当立刻报错，
                                    而不是悄悄跳过。
                                -->
                                <jellyfish.test.examples>${project.basedir}/../../examples/scripts/python</jellyfish.test.examples>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
