<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>zcd</groupId>
        <artifactId>jellyfish-plugins</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>jellyfish-plugin-todo</artifactId>
    <name>Jellyfish Plugin Todo</name>
    <description>官方待办插件：模型可写的 todo_write 工具 + 只读 /todo 命令 + system prompt 注入。</description>

    <dependencies>
        <!-- 内核契约：必须 provided（见 tools 插件的说明）。 -->
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 日志：与内核同源（宿主已有 slf4j），同样走 provided 由父加载器提供。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 待办文件是插件自己的私有格式，内核的 ObjectMapperWrapper 在 jellyfish-infra 里、
             插件看不到它，因此自带 Jackson 并 shade 进插件包（护栏只禁止自带内核契约与 PF4J）。
             这里用显式 @JsonCreator / @JsonProperty 标注私有 DTO，不依赖 -parameters。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- 单测 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 仅测试期使用：加载链路的端到端验证需要真实的 PF4J 管理器与注册表。 -->
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-infra</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 把 Jackson 打进插件包：内核 classpath 上不出现本插件的私有依赖。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>shade-plugin-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <artifactSet>
                                <!-- 只打自己的依赖：jellyfish-api / pf4j 由父加载器提供 -->
                                <includes>
                                    <include>com.fasterxml.jackson.core:*</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
