<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.zcd0831</groupId>
        <artifactId>jellyfish</artifactId>
        <version>0.1.1</version>
    </parent>

    <artifactId>jellyfish-tui</artifactId>
    <name>Jellyfish TUI</name>
    <description>TUI 外壳：TamboUI 声明式界面、TUI 版 ReActListener 与线程契约。</description>

    <properties>
        <!-- TamboUI 只发 SNAPSHOT，而父 POM 自己要发布到中央仓库（release 构件不得依赖 SNAPSHOT），
             所以它的版本只写在 tui 这一层，不进父 POM 的 dependencyManagement：
             tui 是唯一用 TamboUI 的模块，也是不发布的那一个，SNAPSHOT 就止步在这里。
             升级时改这里一处，tamboui-toolkit 与 tamboui-jline3-backend 同步。 -->
        <tamboui.version>0.5.0-SNAPSHOT</tamboui.version>
    </properties>

    <repositories>
        <!-- TamboUI 只发 SNAPSHOT、不在中央仓库，解析它必须有这条快照仓库。
             它只声明在 tui（唯一使用者，且不发布），父 POM 不带：父 POM 要发布到中央仓库，
             不该让使用方继承到一条快照仓库声明。 -->
        <repository>
            <id>ossrh-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.github.zcd0831</groupId>
            <artifactId>jellyfish-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.zcd0831</groupId>
            <artifactId>jellyfish-infra</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.zcd0831</groupId>
            <artifactId>jellyfish-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- TamboUI：声明式 DSL。toolkit 会传递 core / widgets / tui / css / annotations；
             版本由上面的 tamboui.version 给出（父 POM 不出现 TamboUI，理由见那里的注释）。 -->
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-toolkit</artifactId>
            <version>${tamboui.version}</version>
        </dependency>
        <!-- 终端后端：必须显式选一个，TamboUI 自身不带默认后端。
             它传递进来的 jline 是 3.25.1，落在几件 ReDoS 公告的受影响区间里，因此这里排除掉、
             改用下面显式声明的 3.30.17-jdk8（jline 3.x 每个版本都发 jdk8 分类器；
             主线 jar 从 3.26.0 起是 Java 11+ 字节码，JDK 1.8 下不能用）。
             排除是必需的：classifier 不同的 artifact 在 Maven 眼里是两回事，
             不排除就会两个 jar 同时在类路径上（谁先被加载取决于顺序）。 -->
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-jline3-backend</artifactId>
            <version>${tamboui.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.jline</groupId>
                    <artifactId>jline</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>${jline.version}</version>
            <classifier>jdk8</classifier>
        </dependency>

        <!-- Markdown：只用它的 AST 解析器，渲染由我们自己的 text/MarkdownRenderer 承担。
             版本锁在 0.21.0（Java 8 兼容的最后一版），理由见父 POM 的同名属性注释。
             两个扩展都是「识别出来之后按自己的方式渲染」：表格按行列结构画成网格、删除线加 crossedOut。 -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-tables</artifactId>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
        </dependency>

        <!-- 单元测试：投影 / 暂存区 / 监听器这些与 TamboUI 无耦合的纯逻辑 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
